---
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ProfileLinks from "../ProfileLinks.astro";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
---
<div class="card-base p-3">
    <a href={url('/about/')} aria-label={`关于 ${config.name}`}
       class:list={[
           "mx-auto mb-3 mt-3 grid place-items-center overflow-hidden rounded-2xl bg-[var(--btn-regular-bg)] text-3xl font-bold text-[var(--btn-content)] hover:bg-[var(--btn-regular-bg-hover)] active:scale-95 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--primary)]",
           config.avatar ? "h-24 w-24" : "h-16 w-16",
       ]}>
        {config.avatar ? (
            <ImageWrapper src={config.avatar} alt="" position="top" class="h-full w-full origin-top scale-[1.26]" />
        ) : config.name.slice(0, 1)}
    </a>
    <div class="px-2">
        <div class="font-bold text-xl text-center mb-1 dark:text-neutral-50 transition">{config.name}</div>
        <div class="h-1 w-5 bg-[var(--primary)] mx-auto rounded-full mb-2 transition"></div>
        {config.bio && <div class="text-center text-75 mb-3 transition">{config.bio}</div>}
        <ProfileLinks class="mb-1 justify-center" />
    </div>
</div>

