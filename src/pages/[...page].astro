---
import type { GetStaticPaths } from "astro";
import Pagination from "../components/control/Pagination.astro";
import HomeIntro from "../components/HomeIntro.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { url } from "../utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	return paginate(allBlogPosts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;
// https://github.com/withastro/astro/issues/6507#issuecomment-1489916992

const { page } = Astro.props;

const len = page.data.length;
---

<MainGridLayout title={page.currentPage > 1 ? `第 ${page.currentPage} 页` : undefined} description="Liam 的个人主页，记录旅游、音乐、游戏和生活日记。">
    {page.currentPage === 1 && <HomeIntro />}
    <section class={page.currentPage === 1 ? "mt-6" : undefined} aria-labelledby="posts-title">
        <div class="mb-3 flex items-center justify-between gap-3 px-2 md:px-1">
            <h2 id="posts-title" class="text-xl font-bold text-90">最新文章</h2>
            <a class="rounded-md px-2 py-1 text-sm font-medium text-[var(--btn-content)] hover:bg-[var(--btn-plain-bg-hover)]" href={url("/archive/")}>全部归档</a>
        </div>
        {len > 0 ? <PostPage posts={page.data} /> : <p class="card-base px-5 py-6 text-75">还没有文章。</p>}
        <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`} />
    </section>
</MainGridLayout>
